# === LOKO HUB — Environment Variables ===

# Highlightly Soccer API (https://rapidapi.com/highlightly)
HIGHLIGHTLY_API_KEY=your_highlightly_api_key_here

# Supabase (https://supabase.com)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Соль для fingerprint голосований (сгенерируйте: openssl rand -hex 32)
VOTE_FINGERPRINT_SALT=your_random_salt_here
